# Server-side only. None of these are exposed to the browser:
# there is no NEXT_PUBLIC_ prefix on any of them, by design.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# The n8n webhook that kicks off a run.
N8N_WEBHOOK_URL=https://n8n.sylon.ai/webhook/verify

# Optional. If set, sent as x-dashboard-secret so n8n can reject
# anything that did not come from this app.
N8N_WEBHOOK_SECRET=
